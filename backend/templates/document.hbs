<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Processed Document</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #61dafb;
            --primary-hover: #4fa8c7;
            --text-primary: #ffffff;
            --text-secondary: #e5e7eb;
            --bg-color: #282c34;
            --card-bg: #1f2937;
            --border-color: #374151;
            --metadata-bg: #374151;
            --hover-bg: #4b5563;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            background-color: var(--bg-color);
            color: var(--text-primary);
            padding: 2rem;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--border-color);
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .header h2 {
            font-size: 1.25rem;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .metadata {
            background-color: var(--metadata-bg);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .metadata h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .metadata-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .metadata-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .metadata-item i {
            color: var(--primary-color);
            font-size: 1.25rem;
        }

        .main-content {
            background-color: var(--metadata-bg);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .book-entry, .user-profile {
            background-color: var(--card-bg);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .book-entry h3, .user-profile h3 {
            color: var(--primary-color);
            margin-bottom: 1rem;
        }

        .actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin: 2rem 0;
        }

        .button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
            border: none;
        }

        .button-primary {
            background-color: var(--primary-color);
            color: var(--bg-color);
        }

        .button-primary:hover {
            background-color: var(--primary-hover);
        }

        .button-secondary {
            background-color: var(--metadata-bg);
            color: var(--text-primary);
        }

        .button-secondary:hover {
            background-color: var(--hover-bg);
        }

        .footer {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.875rem;
            margin-top: 2rem;
        }

        .document-id {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .copy-button {
            background: none;
            border: none;
            color: var(--primary-color);
            cursor: pointer;
            padding: 0.25rem;
        }

        .copy-button:hover {
            color: var(--primary-hover);
        }

        @media (max-width: 640px) {
            body {
                padding: 1rem;
            }

            .card {
                padding: 1rem;
            }

            .header h1 {
                font-size: 1.5rem;
            }

            .header h2 {
                font-size: 1rem;
            }

            .actions {
                flex-direction: column;
            }

            .button {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    {{#if isAdminOverride}}
        <div class="admin-warning" style="color: red; font-weight: bold; padding: 1rem; border: 2px dashed red; margin-bottom: 1rem;">
            🚨 ADMIN OVERRIDE ENABLED
        </div>
    {{/if}}
    {{#if isArrayPolluted}}
        <div class="array-warning" style="color: red; font-weight: bold; padding: 1rem; border: 2px dashed red; margin-bottom: 1rem;">
            🚨 ARRAY PROTOTYPE POLLUTED
        </div>
    {{/if}}
    <div class="container">
        <div class="card">
            <div class="header">
                <h1>{{title}}</h1>
                {{#if subtitle}}<h2>{{subtitle}}</h2>{{/if}}
            </div>

            {{#if metadata}}
            <div class="metadata">
                <h3>Document Information</h3>
                <div class="metadata-grid">
                    {{#each metadata}}
                    <div class="metadata-item">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <strong>{{@key}}:</strong>
                            <span>{{this}}</span>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            {{#if content}}
            <div class="main-content">
                {{{content}}}
            </div>
            {{/if}}

            {{#if showDownloadButton}}
            <div class="actions">
                <a href="/document/pdf?id={{documentId}}" class="button button-primary">
                    <i class="fas fa-download"></i>
                    Download PDF
                </a>
                <a href="http://localhost:3000" class="button button-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back to Upload
                </a>
            </div>
            {{/if}}

            <div class="footer">
                <p>Generated on {{generatedAt}}</p>
                {{#if documentId}}
                <div class="document-id">
                    <span>Document ID: {{documentId}}</span>
                    <button class="copy-button" onclick="copyToClipboard('{{documentId}}')" title="Copy Document ID">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
                {{/if}}
            </div>
        </div>
    </div>

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const button = event.currentTarget;
                const icon = button.querySelector('i');
                icon.className = 'fas fa-check';
                setTimeout(() => {
                    icon.className = 'fas fa-copy';
                }, 2000);
            });
        }
    </script>
</body>
</html> 